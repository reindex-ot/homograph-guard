{
  "manifest_version": 3,
  "name": "Homograph Guard",
  "version": "1.0.0",
  "description": "ホモグラフ (キリル文字などの紛らわしい文字) を用いた偽装URLを検知しブロックを行います。",
  "permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detector.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "detector.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
